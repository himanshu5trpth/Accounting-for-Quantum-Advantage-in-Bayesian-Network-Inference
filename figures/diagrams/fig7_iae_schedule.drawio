argetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="" style="rounded=1;arcSize=4;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="705.0" y="60.0" width="280.0" height="145.0" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=27;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="705.0" y="60.0" width="280.0" height="22.0" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=0;arcSize=0;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#e1d5e7;strokeWidth=0.01;" vertex="1" parent="1"><mxGeometry x="705.5" y="76.0" width="279.0" height="6.0" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=1.0;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="82" as="sourcePoint"/><mxPoint x="985" y="82" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="ESTIMATE" style="text;html=1;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;spacingLeft=4;spacingRight=4;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="809.9" y="63.3" width="70.2" height="20.2" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;arcSize=11;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="713.0" y="90.0" width="264.0" height="107.0" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Stop:&lt;/b&gt; interval narrower than 2ε&lt;i&gt;a&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;spacingLeft=4;spacingRight=4;fontFamily=Times New Roman;fontSize=12.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="715.0" y="116.1" width="236.0" height="19.6" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Amplitudes:&lt;/b&gt; &lt;i&gt;â&lt;/i&gt;&lt;sub&gt;E&lt;/sub&gt; and &lt;i&gt;â&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;spacingLeft=4;spacingRight=4;fontFamily=Times New Roman;fontSize=12.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="715.0" y="136.1" width="159.0" height="19.6" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Posterior:&lt;/b&gt; &lt;i&gt;p̂&lt;/i&gt; = &lt;i&gt;â&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; / &lt;i&gt;â&lt;/i&gt;&lt;sub&gt;E&lt;/sub&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;spacingLeft=4;spacingRight=4;fontFamily=Times New Roman;fontSize=12.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="715.0" y="156.1" width="173.0" height="19.6" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Cost:&lt;/b&gt; Σ &lt;i&gt;N&lt;/i&gt;(2&lt;i&gt;k&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt; + 1) passes ≈ κ (π/ε)(1/√&lt;i&gt;a&lt;/i&gt;),  with κ ≈ 12 for tuned IAE (16 shots, α = 0.2) in the flat region" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;spacingLeft=4;spacingRight=4;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="11.0" y="237.7" width="798.2" height="20.2" as="geometry"/></mxCell><mxCell id="c59" value="Each round takes the largest power that keeps the amplitude angle in one half-plane, so the interval narrows (bars are schematic)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;spacingLeft=4;spacingRight=4;fontFamily=Times New Roman;fontSize=12;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="11.0" y="264.6" width="885.6" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
